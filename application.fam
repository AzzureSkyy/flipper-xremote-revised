App(
    appid="xremote",
    name="XRemote",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="xremote_main",
    stack_size=3 * 1024,
    fap_category="Infrared",
    fap_icon_assets="assets",
    fap_libs=["assets"],
    fap_icon_assets_symbol="xc",
    fap_icon="assets/App_Icon_10x10.png",
    fap_author="Sandro Kalatozishvili; revisions by AzureSky",
    fap_weburl="https://github.com/AzzureSkyy/flipper-xremote-revised",
    fap_version="1.5",
    fap_description="Advanced infrared remote control",
)
